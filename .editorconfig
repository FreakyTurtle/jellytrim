# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go and go.mod: gofmt uses tabs.
[{*.go,go.mod,go.sum}]
indent_style = tab
indent_size = 4

# templ: tabs, to match templ fmt.
[*.templ]
indent_style = tab
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

[*.py]
indent_size = 4

[{*.md,*.yml,*.yaml,*.json,*.toml,*.css,*.js,*.sh}]
indent_style = space
indent_size = 2
