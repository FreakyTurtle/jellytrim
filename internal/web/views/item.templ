package views

import "fmt"

// ItemPageData is everything the item detail page shows.
type ItemPageData struct {
	Shell         Shell
	ID            string
	Title         string
	Subtitle      string
	HasImage      bool
	ImgSrc        string
	Initial       string
	ReprobeAction string
	Lamp          string
	Outcome       string
	Summary       string
	Badges        []LibraryBadge
	Inspecting    bool   // an "Inspect again" run is going
	ProbeError    string // why the file could not be inspected, technical
	Probed        bool
	Jellyfin      []ItemStat
	Watch         ItemWatch
	Source        []ItemStat
	HDRFacts      []string
	Audio         []ItemStream
	Subtitles     []ItemStream
	Extras        []ItemStat
	Policy        ItemPolicy
	Proposed      []ItemStat
	Estimate      *ItemEstimate
	Optimise      ItemOptimise
}

// ItemStat is one label and value in a spec sheet.
type ItemStat struct {
	Label string
	Value string
	Mono  bool
}

// ItemWatch is every Jellyfin user's watch state for the item, with the
// rule that decides whether it counts as watched.
type ItemWatch struct {
	Rule string // "A file counts as watched when a majority of ..."
	Rows []ItemWatchRow
}

// ItemWatchRow is one Jellyfin user's watch state for the item.
type ItemWatchRow struct {
	Name       string
	Played     bool
	When       string // "3 plays, last 12 days ago"; empty when never played
	Favourite  bool
	Counted    bool
	Why        string // why not counted, or a note on a counted user
}

// ItemStream is one audio or subtitle stream.
type ItemStream struct {
	Index    string
	Codec    string
	Channels string
	Language string
	Title    string
	Flags    string
}

// ItemPolicy explains which policy decides the item and why.
type ItemPolicy struct {
	Evaluated bool
	Heading   string
	Winner    string
	Lines     []ExplainLine // the winning policy's checks
	Reasons   []ExplainLine // why the item is skipped
	Also      []string      // other enabled policies that matched
	Off       []string      // turned-off policies that matched
	Unmatched []ItemPolicyMatch
}

// ItemPolicyMatch is a policy that did not match, with its checks.
type ItemPolicyMatch struct {
	Name    string
	Enabled bool
	Lines   []ExplainLine
}

// ItemEstimate is the estimated output size against the current size.
type ItemEstimate struct {
	Current   string
	Range     string
	Saving    string
	LoPercent int // estimated size range as a share of the current size
	HiPercent int
}

// ItemOptimise is the Optimise now button and why it cannot be used.
type ItemOptimise struct {
	Show          bool   // JellyTrim plans to optimise the item
	Enabled       bool   // the button works (Dry Run is off)
	Reason        string // why the button is disabled
	Action        string // POST target that queues the item
	Backup        string // how long the original is kept, for the confirmation
	Queued        bool   // the item already has a waiting or running job
	Excluded      bool   // the user restored the original, so it is left alone
	IncludeAction string // POST target that allows changes again
	Error         *QueueNotice
}

func itemBarStyle(e ItemEstimate) templ.SafeCSS {
	return templ.SafeCSS(fmt.Sprintf("--est-lo: %d%%; --est-hi: %d%%;", e.LoPercent, e.HiPercent))
}

func itemUnmatchedSummary(n int) string {
	if n == 1 {
		return "1 policy did not match"
	}
	return fmt.Sprintf("%d policies did not match", n)
}

// ItemPage is the item detail page.
templ ItemPage(v ItemPageData) {
	@Layout(v.Shell) {
		<p class="item-back"><a href="/library">Library</a></p>
		@PageHeader(v.Title, v.Subtitle) {
			@itemActions(v)
		}
		if v.Optimise.Error != nil {
			@QueueNoticeCallout(*v.Optimise.Error)
		}
		if v.Inspecting {
			@Callout("info", "Inspecting this file again", "JellyTrim is inspecting the file and evaluating it again. Reload this page in a moment to see the result.")
		}
		if v.ProbeError != "" {
			@Callout("bad", "JellyTrim could not inspect this file", "The file is unchanged and JellyTrim will not change it. Check that the file exists at the local path and that JellyTrim can read it, then press Inspect again.") {
				@TechnicalDetails("Technical details", v.ProbeError)
			}
		}
		@itemOverview(v)
		<div class="item-grid">
			<div class="item-grid__col">
				@Panel("Jellyfin", "item-jellyfin") {
					@itemStats(v.Jellyfin)
				}
				if v.Watch.Rule != "" {
					@itemWatch(v.Watch)
				}
				if v.Probed {
					@Panel("Source", "item-source") {
						@itemStats(v.Source)
						if len(v.HDRFacts) > 0 {
							<div class="item-facts">
								<p class="item-facts__label">How the dynamic range was worked out</p>
								@Explain(itemFactLines(v.HDRFacts))
							</div>
						}
					}
					@itemStreams(v)
				}
			</div>
			<div class="item-grid__col">
				@itemPolicy(v.Policy)
				if len(v.Proposed) > 0 {
					@Panel("Proposed", "item-proposed") {
						@itemStats(v.Proposed)
					}
				}
				if v.Estimate != nil {
					@itemEstimate(*v.Estimate)
				}
			</div>
		</div>
		if v.Optimise.Show && v.Optimise.Enabled && !v.Optimise.Queued {
			@itemOptimiseDialog(v)
		}
	}
}

const itemOptimiseDialogID = "item-optimise"

// itemOptimiseDialog confirms queueing the item. Without JavaScript the
// trigger link opens it through :target, and "Not now" links back to the page.
templ itemOptimiseDialog(v ItemPageData) {
	@Dialog(itemOptimiseDialogID, "Optimise now?") {
		<form class="queue-dialog__form" method="post" action={ templ.SafeURL(v.Optimise.Action) }>
			@DialogBody() {
				<p>Optimise <strong>{ v.Title }</strong> now? JellyTrim will replace the file after checking the result.</p>
				<p>{ v.Optimise.Backup }</p>
			}
			@DialogActions() {
				@DialogCancel("Not now")
				<a class="btn btn--secondary queue-nojs" href="#main">Not now</a>
				<button class="btn btn--primary" type="submit">Optimise now</button>
			}
		</form>
	}
}

func itemFactLines(facts []string) []ExplainLine {
	out := make([]ExplainLine, 0, len(facts))
	for _, f := range facts {
		out = append(out, ExplainLine{Neutral: true, Text: f})
	}
	return out
}

templ itemActions(v ItemPageData) {
	<div class="item-actions">
		if v.Optimise.Queued {
			<div class="item-actions__optimise">
				<p class="actions__note">
					@Status("active-steady", "Queued")
				</p>
				<a class="btn btn--secondary" href="/queue">View the queue</a>
			</div>
		} else if v.Optimise.Show && v.Optimise.Enabled {
			<div class="item-actions__optimise">
				<a class="btn btn--primary" href={ templ.SafeURL("#" + itemOptimiseDialogID) } data-dialog-open={ itemOptimiseDialogID } aria-haspopup="dialog">Optimise now</a>
			</div>
		} else if v.Optimise.Show {
			<div class="item-actions__optimise">
				<button class="btn btn--primary" type="button" disabled aria-describedby="item-optimise-note">Optimise now</button>
				<p class="actions__note" id="item-optimise-note">{ v.Optimise.Reason }</p>
			</div>
		}
		if v.Optimise.Excluded {
			<form class="item-actions__optimise" method="post" action={ templ.SafeURL(v.Optimise.IncludeAction) }>
				<button class="btn btn--secondary" type="submit" aria-describedby="item-include-note">Allow changes again</button>
				<p class="actions__note" id="item-include-note">You restored the original. Allow JellyTrim to change this item again.</p>
			</form>
		}
		<form method="post" action={ templ.SafeURL(v.ReprobeAction) }>
			<button class="btn btn--secondary" type="submit">Inspect again</button>
		</form>
	</div>
}

templ itemOverview(v ItemPageData) {
	@PanelWith(PanelProps{Tab: "Decision", ID: "item-decision", Variant: "emphasis"}) {
		<div class="item-overview">
			@LibraryArt(v.HasImage, v.ImgSrc, v.Initial, true)
			<div class="item-overview__text">
				<p class="item-overview__status">
					@Status(v.Lamp, v.Outcome)
				</p>
				if v.Summary != "" {
					<p>{ v.Summary }</p>
				}
				if len(v.Badges) > 0 {
					<p class="badges" aria-label="Current format">
						for _, b := range v.Badges {
							@Badge(b.Text, b.Variant)
						}
					</p>
				}
			</div>
		</div>
	}
}

templ itemStats(rows []ItemStat) {
	@Stats() {
		for _, r := range rows {
			@StatRow(r.Label, r.Value, r.Mono)
		}
	}
}

// itemWatch lists each Jellyfin user's watch state for the item and
// whether it counts, under the rule in words.
templ itemWatch(w ItemWatch) {
	@Panel("Watch history", "item-watch") {
		<p class="item-watch__rule">{ w.Rule }</p>
		if len(w.Rows) > 0 {
			<div class="table-wrap">
				<table class="table item-watch__table" role="table">
					<caption class="visually-hidden">Watch history by person</caption>
					<thead role="rowgroup">
						<tr role="row">
							<th scope="col" role="columnheader">Person</th>
							<th scope="col" role="columnheader">Watched</th>
							<th scope="col" role="columnheader">Favourite</th>
							<th scope="col" role="columnheader">Counts</th>
						</tr>
					</thead>
					<tbody role="rowgroup">
						for _, r := range w.Rows {
							<tr role="row" class={ templ.KV("item-watch__row--off", !r.Counted) }>
								<td role="cell" class="item-watch__name">{ r.Name }</td>
								<td role="cell" data-label="Watched">
									<span class="item-watch__played">
										if r.Played {
											<span class="item-watch__yes">Yes</span>
										} else {
											<span class="missing">No</span>
										}
										if r.When != "" {
											<span class="item-watch__when mono">{ r.When }</span>
										}
									</span>
								</td>
								<td role="cell" data-label="Favourite">
									if r.Favourite {
										Yes
									} else {
										<span class="missing">No</span>
									}
								</td>
								<td role="cell" data-label="Counts">@Counted(r.Counted, r.Why)</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<p class="item-note">Favourites and "last watched" use any counted person, and inactive people too. Other people who are not counted do not affect this file.</p>
		}
	}
}

templ itemStreams(v ItemPageData) {
	@Panel("Streams", "item-streams") {
		<h3 class="item-subhead">Audio</h3>
		if len(v.Audio) == 0 {
			<p class="item-note">No audio streams.</p>
		} else {
			<div class="table-wrap">
				<table class="table" role="table">
					<caption class="visually-hidden">Audio streams</caption>
					<thead role="rowgroup">
						<tr role="row">
							<th scope="col" role="columnheader" class="num">#</th>
							<th scope="col" role="columnheader">Codec</th>
							<th scope="col" role="columnheader">Channels</th>
							<th scope="col" role="columnheader">Language</th>
							<th scope="col" role="columnheader">Title</th>
							<th scope="col" role="columnheader">Flags</th>
						</tr>
					</thead>
					<tbody role="rowgroup">
						for _, a := range v.Audio {
							<tr role="row">
								<td role="cell" data-label="#" class="num mono">{ a.Index }</td>
								<td role="cell" data-label="Codec" class="mono">@ValueOr(a.Codec, "Unknown")</td>
								<td role="cell" data-label="Channels" class="mono">@ValueOr(a.Channels, "Unknown")</td>
								<td role="cell" data-label="Language" class="mono">@ValueOr(a.Language, "Unknown")</td>
								<td role="cell" data-label="Title">@ValueOr(a.Title, "None")</td>
								<td role="cell" data-label="Flags">@ValueOr(a.Flags, "None")</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<h3 class="item-subhead">Subtitles</h3>
		if len(v.Subtitles) == 0 {
			<p class="item-note">No subtitle streams.</p>
		} else {
			<div class="table-wrap">
				<table class="table" role="table">
					<caption class="visually-hidden">Subtitle streams</caption>
					<thead role="rowgroup">
						<tr role="row">
							<th scope="col" role="columnheader" class="num">#</th>
							<th scope="col" role="columnheader">Codec</th>
							<th scope="col" role="columnheader">Language</th>
							<th scope="col" role="columnheader">Title</th>
							<th scope="col" role="columnheader">Flags</th>
						</tr>
					</thead>
					<tbody role="rowgroup">
						for _, s := range v.Subtitles {
							<tr role="row">
								<td role="cell" data-label="#" class="num mono">{ s.Index }</td>
								<td role="cell" data-label="Codec" class="mono">@ValueOr(s.Codec, "Unknown")</td>
								<td role="cell" data-label="Language" class="mono">@ValueOr(s.Language, "Unknown")</td>
								<td role="cell" data-label="Title">@ValueOr(s.Title, "None")</td>
								<td role="cell" data-label="Flags">@ValueOr(s.Flags, "None")</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<h3 class="item-subhead">Other</h3>
		@itemStats(v.Extras)
	}
}

templ itemPolicy(p ItemPolicy) {
	@Panel("Policy", "item-policy") {
		if !p.Evaluated {
			<p class="item-note">Not evaluated yet. The next sync inspects and evaluates this item.</p>
		} else {
			<h3 class="item-policy__heading">{ p.Heading }</h3>
			if len(p.Reasons) > 0 {
				@Explain(p.Reasons)
			}
			if p.Winner != "" && len(p.Lines) > 0 {
				if len(p.Reasons) > 0 {
					<p class="item-note">{ p.Winner } matched this item:</p>
				}
				@Explain(p.Lines)
			}
			if len(p.Also) > 0 {
				<div class="item-policy__group">
					<p class="item-facts__label">Also matched, not applied</p>
					<ul class="item-list">
						for _, a := range p.Also {
							<li>{ a }</li>
						}
					</ul>
				</div>
			}
			if len(p.Off) > 0 {
				<div class="item-policy__group">
					<p class="item-facts__label">Turned off</p>
					<ul class="item-list">
						for _, o := range p.Off {
							<li>{ o }</li>
						}
					</ul>
				</div>
			}
			if len(p.Unmatched) > 0 {
				<details class="item-details">
					<summary>{ itemUnmatchedSummary(len(p.Unmatched)) }</summary>
					<div class="item-details__body">
						for _, m := range p.Unmatched {
							<div class="item-policy__group">
								<p class="item-policy__name">
									{ m.Name }
									if !m.Enabled {
										<span class="item-policy__off">(turned off)</span>
									}
								</p>
								@Explain(m.Lines)
							</div>
						}
					</div>
				</details>
			}
		}
	}
}

templ itemEstimate(e ItemEstimate) {
	@Panel("Estimated size", "item-estimate") {
		<p class="item-estimate__range">
			<span class="item-estimate__approx" aria-hidden="true">~</span><span class="visually-hidden">About </span>{ e.Range }
		</p>
		<p class="item-estimate__saving">Estimated saving <span class="mono"><span aria-hidden="true">~ </span><span class="visually-hidden">about </span>{ e.Saving }</span></p>
		<div class="size-bar" style={ itemBarStyle(e) } aria-hidden="true">
			<span class="size-bar__row"><span class="size-bar__label">Now</span><span class="size-bar__track"><span class="size-bar__now"></span></span></span>
			<span class="size-bar__row"><span class="size-bar__label">After</span><span class="size-bar__track size-bar__track--est"><span class="size-bar__est"></span></span></span>
		</div>
		<p class="item-note">Now { e.Current }. Estimated from the video bitrate, the target resolution and the chosen quality. Real results vary.</p>
	}
}

// ItemNotFound is shown for an item ID the library does not have.
templ ItemNotFound(s Shell) {
	@Layout(s) {
		@PageHeader("Item not found", "")
		@Panel("Library", "item-missing") {
			@EmptyState("0", "This item is not in the library", "Jellyfin may have removed it since the last sync.", "/library", "Go to the Library")
		}
	}
}
