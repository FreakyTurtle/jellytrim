package views

import "strconv"

// SetupTotalSteps is the number of steps in the setup wizard.
const SetupTotalSteps = 8

// SetupConnResult is the outcome of a Jellyfin connection test or another
// check, shown as a callout. It never carries the API key.
type SetupConnResult struct {
	Variant string // "ok", "warn" or "bad"
	Title   string
	Text    string
	Detail  string // technical details, shown in a closed <details>
}

// SetupJellyfinView is the Jellyfin connection form.
type SetupJellyfinView struct {
	URL      string
	HasKey   bool // an API key is saved; the field itself is always empty
	URLError string
	KeyError string
	Result   *SetupConnResult
}

// SetupLibrary is one Jellyfin library in a checklist.
type SetupLibrary struct {
	ID        string
	Name      string
	Type      string // "Movies", "Shows", "Music"...
	Locations []string
	Supported bool
	Reason    string // why an unsupported library cannot be chosen
	Checked   bool
}

// SetupUser is one enabled Jellyfin user in a checklist.
type SetupUser struct {
	ID      string
	Name    string
	Checked bool
}

// SetupLibrariesView is the libraries and watched state step.
type SetupLibrariesView struct {
	Libraries    []SetupLibrary
	Users        []SetupUser
	WatchMode    string // "any" or "all"
	LibraryError string
	UserError    string
	LoadError    *SetupConnResult
}

// SetupPathRow is one path mapping row as entered.
type SetupPathRow struct {
	Jellyfin      string
	Local         string
	FromLibrary   bool // the Jellyfin path is a library location: read-only
	JellyfinError string
	LocalError    string
}

// SetupPathResult is the check result for one mapping.
type SetupPathResult struct {
	Jellyfin string
	Local    string
	Variant  string // "ok", "warn" or "bad"
	Text     string
	Missing  []string
}

// SetupPathsView is the path mapping rows, errors and check results.
type SetupPathsView struct {
	Rows       []SetupPathRow
	Error      string
	Results    []SetupPathResult
	CheckError *SetupConnResult
}

// SetupCapability is one encoder backend's hardware test result.
type SetupCapability struct {
	Label   string
	Backend string
	Codec   string
	Device  string
	Result  string // "works", "failed" or "unavailable"
	Notes   string
}

// SetupHardwareView is the encoder table with its "Test again" action.
type SetupHardwareView struct {
	Available     bool // the hardware test can run in this build
	Caps          []SetupCapability
	FFmpegVersion string
	TestedAt      string
	Error         string
	Action        string // where "Test again" posts
}

// SetupDefaultsView is the default strategy step.
type SetupDefaultsView struct {
	Quality string
	Codec   string
	Encoder string // "hardware" (Auto) or "software"
	Error   string
}

// SetupPolicyCard is one starter policy.
type SetupPolicyCard struct {
	Name     string
	Sentence string
	Enabled  bool
	TV       bool // needs the TV library picker
}

// SetupPoliciesView is the starter policies step.
type SetupPoliciesView struct {
	Cards       []SetupPolicyCard
	TVLibraries []SetupLibrary
	Existing    bool // the policies were created on an earlier visit
}

// SetupScanLine is one counted line in the Dry Run summary.
type SetupScanLine struct {
	Count string
	Text  string
}

// SetupScanSummary is the Dry Run summary shown when the scan finishes.
type SetupScanSummary struct {
	Evaluated   string
	Optimise    string
	SavingValue string
	SavingUnit  string
	SavingNote  string
	Estimate    bool // the saving is an estimate, shown with "~"
	Lines       []SetupScanLine
}

// SetupScanView is the Dry Run scan state.
type SetupScanView struct {
	State   string // "ready", "running", "failed" or "done"
	Phase   string
	Percent int // negative for an indeterminate meter
	Readout string
	Error   string
	Summary *SetupScanSummary
}

func setupKeyHint(hasKey bool) string {
	if hasKey {
		return "An API key is saved. Enter a new key only to replace it."
	}
	return "In Jellyfin, open Dashboard, then API Keys, and add a key named JellyTrim."
}

func setupResultID(from string) string { return from + "-jf-result" }

func setupPathResultsID(from string) string { return from + "-path-results" }

func setupRowID(from, part string, i int) string {
	return from + "-path-" + part + "-" + strconv.Itoa(i)
}

func setupCardID(i int) string { return "setup-policy-" + strconv.Itoa(i) }

// setupDefaultSubmit is the form's first submit button, so pressing Enter in
// a text field continues rather than pressing a row's Remove button.
templ setupDefaultSubmit(label string) {
	<button class="visually-hidden" type="submit" tabindex="-1" aria-hidden="true">{ label }</button>
}

templ setupActions(back string) {
	<div class="setup__actions">
		if back != "" {
			<a class="btn btn--secondary" href={ templ.SafeURL(back) }>Back</a>
		}
		<button class="btn btn--primary" type="submit">Continue</button>
	</div>
}

// SetupConnResultView shows a connection test or check result. Results
// appear after the user acted, so errors are announced.
templ SetupConnResultView(r SetupConnResult) {
	@CalloutWith(CalloutProps{Variant: r.Variant, Title: r.Title, Text: r.Text, Alert: r.Variant == "bad"}) {
		if r.Detail != "" {
			@TechnicalDetails("Technical details", r.Detail)
		}
	}
}

// ---------- 1. Welcome ----------

// SetupWelcome is step 1.
templ SetupWelcome(assetVersion string) {
	@SetupLayout("Welcome", 1, SetupTotalSteps, assetVersion) {
		@PageHeader("Welcome to JellyTrim", "JellyTrim makes your Jellyfin library smaller, and leaves alone what matters to you.")
		<form class="setup-step" method="post" action="/setup/welcome">
			@Panel("What it does", "setup-about") {
				<ol class="setup-points">
					<li class="setup-points__item">
						<span class="setup-points__num" aria-hidden="true">A</span>
						<p><strong>Reads your library.</strong> It reads what Jellyfin knows, including who watched what and your favourites, and inspects each file.</p>
					</li>
					<li class="setup-points__item">
						<span class="setup-points__num" aria-hidden="true">B</span>
						<p><strong>Follows your policies.</strong> Short rules decide what to convert, for example watched 4K films to 1080p HEVC, and what never to touch.</p>
					</li>
					<li class="setup-points__item">
						<span class="setup-points__num" aria-hidden="true">C</span>
						<p><strong>Replaces files carefully.</strong> A new file replaces the original only after it passes a check, and the original is kept as a backup for a while.</p>
					</li>
				</ol>
			}
			@Callout("info", "Dry Run is on", "JellyTrim will not change any files until you turn it off. Setup takes a few minutes, and nothing changes until you say so.")
			<div class="setup__actions">
				<button class="btn btn--primary" type="submit">Start setup</button>
			</div>
		</form>
	}
}

// ---------- 2. Connect Jellyfin ----------

// SetupJellyfin is step 2.
templ SetupJellyfin(v SetupJellyfinView, assetVersion string) {
	@SetupLayout("Connect Jellyfin", 2, SetupTotalSteps, assetVersion) {
		@PageHeader("Connect Jellyfin", "JellyTrim reads your library and watch history through Jellyfin's API.")
		<form class="setup-step" method="post" action="/setup/jellyfin" novalidate>
			@setupDefaultSubmit("Continue")
			@Panel("Jellyfin", "setup-jellyfin") {
				@SetupJellyfinFields(v, "setup")
			}
			@setupActions("/setup/welcome")
		</form>
	}
}

// SetupJellyfinFields is the address and key fields with "Test connection".
// from is "setup" or "settings"; it keeps ids unique and tells the test
// handler which page to show without JavaScript.
templ SetupJellyfinFields(v SetupJellyfinView, from string) {
	<div class="setup-fields">
		@Field(FieldProps{ID: from + "-jf-url", Name: "url", Label: "Jellyfin address", Hint: "The address JellyTrim uses to reach Jellyfin, for example http://jellyfin:8096.", Type: "url", Value: v.URL, Placeholder: "http://jellyfin:8096", Error: v.URLError, Mono: true, Attrs: templ.Attributes{"autocomplete": "off", "spellcheck": "false", "autocapitalize": "off"}})
		@Field(FieldProps{ID: from + "-jf-key", Name: "key", Label: "API key", Hint: setupKeyHint(v.HasKey), Type: "password", Error: v.KeyError, Mono: true, Attrs: templ.Attributes{"autocomplete": "off", "spellcheck": "false", "autocapitalize": "off"}})
		<div class="actions">
			<button
				class="btn btn--secondary"
				type="submit"
				name="from"
				value={ from }
				formaction="/setup/jellyfin/test"
				formnovalidate
				hx-post="/setup/jellyfin/test"
				hx-target={ "#" + setupResultID(from) }
				hx-swap="innerHTML"
				hx-disabled-elt="this"
			>Test connection</button>
		</div>
		<div class="setup-result" id={ setupResultID(from) }>
			if v.Result != nil {
				@SetupConnResultView(*v.Result)
			}
		</div>
	</div>
}

// ---------- 3. Libraries and watched state ----------

// SetupLibraries is step 3.
templ SetupLibraries(v SetupLibrariesView, assetVersion string) {
	@SetupLayout("Libraries", 3, SetupTotalSteps, assetVersion) {
		@PageHeader("Libraries and watched state", "Choose what JellyTrim manages, and whose viewing counts.")
		<form class="setup-step" method="post" action="/setup/libraries">
			if v.LoadError != nil {
				@SetupConnResultView(*v.LoadError)
			}
			@Panel("Libraries", "setup-libraries") {
				@SetupLibraryList(v.Libraries, v.LibraryError, "setup")
			}
			@Panel("Watched state", "setup-users") {
				@SetupUserList(v.Users, v.WatchMode, v.UserError, "setup")
			}
			@setupActions("/setup/jellyfin")
		</form>
	}
}

// SetupLibraryList is the library checklist. Unsupported libraries are
// listed but cannot be chosen, with the reason.
templ SetupLibraryList(libs []SetupLibrary, errText string, from string) {
	<fieldset
		class="setup-checklist"
		if errText != "" {
			aria-describedby={ from + "-library-error" }
		}
	>
		<legend class="setup-checklist__legend">Libraries JellyTrim manages</legend>
		if errText != "" {
			<p class="field__error" id={ from + "-library-error" }><span aria-hidden="true">✗</span> { errText }</p>
		}
		if len(libs) == 0 {
			<p class="setup-note">Jellyfin did not report any libraries. Add a library in Jellyfin, then reload this page.</p>
		}
		<ul class="setup-checklist__list">
			for _, l := range libs {
				<li class={ "setup-checklist__item", templ.KV("setup-checklist__item--off", !l.Supported) }>
					<label class="check">
						<input
							type="checkbox"
							name="library"
							value={ l.ID }
							checked?={ l.Checked && l.Supported }
							disabled?={ !l.Supported }
						/>
						<span class="setup-checklist__text">
							<span class="setup-checklist__name">{ l.Name }</span>
							@Badge(l.Type, "muted")
							for _, loc := range l.Locations {
								<span class="setup-checklist__path mono">{ loc }</span>
							}
							if !l.Supported {
								<span class="setup-checklist__reason">{ l.Reason }</span>
							}
						</span>
					</label>
				</li>
			}
		</ul>
	</fieldset>
}

func setupUserNames(users []SetupUser) string {
	var names []string
	for _, u := range users {
		if u.Checked {
			names = append(names, u.Name)
		}
	}
	switch len(names) {
	case 0:
		return "the selected users"
	case 1:
		return names[0]
	}
	out := names[0]
	for i := 1; i < len(names)-1; i++ {
		out += ", " + names[i]
	}
	return out + " and " + names[len(names)-1]
}

func setupWatchOptions(users []SetupUser) []Option {
	names := setupUserNames(users)
	return []Option{
		{Value: "any", Label: "Any of them", Hint: "An item counts as watched when any of " + names + " has watched it."},
		{Value: "all", Label: "All of them", Hint: "An item counts as watched only when all of " + names + " have watched it."},
	}
}

// SetupUserList is the checklist of enabled Jellyfin users and the any or
// all choice.
templ SetupUserList(users []SetupUser, mode string, errText string, from string) {
	<div class="setup-fields">
		<fieldset
			class="setup-checklist"
			if errText != "" {
				aria-describedby={ from + "-user-error" }
			}
		>
			<legend class="setup-checklist__legend">Whose watched state counts?</legend>
			<p class="field__hint">Watched and favourite conditions in policies use these people's viewing.</p>
			if errText != "" {
				<p class="field__error" id={ from + "-user-error" }><span aria-hidden="true">✗</span> { errText }</p>
			}
			if len(users) == 0 {
				<p class="setup-note">Jellyfin did not report any enabled users.</p>
			}
			<ul class="setup-checklist__list setup-checklist__list--inline">
				for _, u := range users {
					<li class="setup-checklist__item">
						<label class="check">
							<input type="checkbox" name="user" value={ u.ID } checked?={ u.Checked }/>
							<span>{ u.Name }</span>
						</label>
					</li>
				}
			</ul>
		</fieldset>
		@Segmented("watch_mode", "An item counts as watched when", setupWatchOptions(users), mode, "")
	</div>
}

// ---------- 4. Path mappings ----------

// SetupPaths is step 4.
templ SetupPaths(v SetupPathsView, assetVersion string) {
	@SetupLayout("Path mappings", 4, SetupTotalSteps, assetVersion) {
		@PageHeader("Path mappings", "Tell JellyTrim where it can find the files that Jellyfin sees.")
		<form class="setup-step" method="post" action="/setup/paths" novalidate>
			@setupDefaultSubmit("Continue")
			@Panel("Mappings", "setup-paths") {
				@SetupPathRows(v, "setup")
			}
			@setupActions("/setup/libraries")
		</form>
	}
}

// SetupPathRows is the editable mapping rows, "Add mapping", "Check paths"
// and the check results.
templ SetupPathRows(v SetupPathsView, from string) {
	<div class="setup-fields">
		<p class="setup-note">Each row pairs a folder as Jellyfin sees it with the same folder inside JellyTrim's container. The two differ when they run in separate containers.</p>
		if v.Error != "" {
			@CalloutWith(CalloutProps{Variant: "bad", Title: v.Error, Alert: true})
		}
		<ol class="setup-paths">
			for i, row := range v.Rows {
				<li class="setup-paths__row">
					<span class="setup-paths__num mono" aria-hidden="true">{ twoDigits(i + 1) }</span>
					@Field(FieldProps{ID: setupRowID(from, "jf", i), Name: "jellyfin", Label: "Jellyfin path", Value: row.Jellyfin, Placeholder: "/media/movies", Mono: true, ReadOnly: row.FromLibrary, Error: row.JellyfinError, Attrs: templ.Attributes{"spellcheck": "false", "autocapitalize": "off"}})
					<span class="setup-paths__arrow" aria-hidden="true">→</span>
					@Field(FieldProps{ID: setupRowID(from, "local", i), Name: "local", Label: "JellyTrim path", Value: row.Local, Placeholder: "/mnt/media/movies", Mono: true, Error: row.LocalError, Attrs: templ.Attributes{"spellcheck": "false", "autocapitalize": "off"}})
					<button class="btn btn--secondary btn--small setup-paths__remove" type="submit" name="remove" value={ strconv.Itoa(i) } formnovalidate>
						Remove<span class="visually-hidden">{ " mapping " + strconv.Itoa(i+1) }</span>
					</button>
				</li>
			}
		</ol>
		<div class="actions">
			<button class="btn btn--secondary" type="submit" name="add" value="1" formnovalidate>Add mapping</button>
			<button
				class="btn btn--secondary"
				type="submit"
				name="from"
				value={ from }
				formaction="/setup/paths/check"
				formnovalidate
				hx-post="/setup/paths/check"
				hx-target={ "#" + setupPathResultsID(from) }
				hx-swap="innerHTML"
				hx-disabled-elt="this"
			>Check paths</button>
			<p class="actions__note">The check looks for a sample of your files and tries to write, hard-link and rename a hidden test file.</p>
		</div>
		<div class="setup-results" id={ setupPathResultsID(from) }>
			@SetupPathResults(v)
		</div>
	</div>
}

// SetupPathResults is the per-mapping check result list.
templ SetupPathResults(v SetupPathsView) {
	if v.CheckError != nil {
		@SetupConnResultView(*v.CheckError)
	}
	if len(v.Results) > 0 {
		<ul class="setup-results__list">
			for _, r := range v.Results {
				<li class={ "setup-results__item", "setup-results__item--" + r.Variant }>
					<p class="setup-results__paths mono">{ r.Jellyfin } → { r.Local }</p>
					<p class="setup-results__text">
						@Lamp(r.Variant)
						<span>{ r.Text }</span>
					</p>
					if len(r.Missing) > 0 {
						<ul class="setup-results__missing">
							for _, m := range r.Missing {
								<li class="mono">{ m }</li>
							}
						</ul>
					}
				</li>
			}
		</ul>
	}
}

// ---------- 5. Hardware ----------

// SetupHardware is step 5.
templ SetupHardware(v SetupHardwareView, assetVersion string) {
	@SetupLayout("Hardware", 5, SetupTotalSteps, assetVersion) {
		@PageHeader("Hardware", "JellyTrim tests each encoder with a short encode. It does not just trust what ffmpeg lists.")
		<form class="setup-step" method="post" action="/setup/hardware">
			@Panel("Encoders", "setup-hardware") {
				@SetupHardwareBody(v)
			}
			<p class="setup-note">Software encoding (x265) always works, so this step never blocks setup.</p>
			@setupActions("/setup/paths")
		</form>
	}
}

func setupResultWord(result string) string {
	switch result {
	case "works":
		return "Works"
	case "failed":
		return "Failed"
	}
	return "Not available"
}

func setupResultMark(result string) string {
	if result == "works" {
		return "✓"
	}
	return "✗"
}

// SetupHardwareBody is the encoder table and "Test again". It is swapped
// whole after a re-test.
templ SetupHardwareBody(v SetupHardwareView) {
	<div class="setup-hardware" id="hardware-body">
		if !v.Available {
			@Callout("info", "The hardware test is not available yet", "The test runs when encoders are available in this build. Software encoding (x265) always works, so you can carry on.")
		} else {
			if v.Error != "" {
				@CalloutWith(CalloutProps{Variant: "bad", Title: "The hardware test failed", Text: v.Error, Alert: true})
			}
			if v.FFmpegVersion != "" {
				<p class="setup-note">ffmpeg <span class="mono">{ v.FFmpegVersion }</span></p>
			}
			if len(v.Caps) == 0 {
				<p class="setup-note">No test results yet. Press Test again to run the test.</p>
			} else {
				<div class="table-wrap">
					<table class="table" role="table">
						<caption class="visually-hidden">Encoder test results</caption>
						<thead role="rowgroup">
							<tr role="row">
								<th scope="col" role="columnheader">Encoder</th>
								<th scope="col" role="columnheader">Codec</th>
								<th scope="col" role="columnheader">Device</th>
								<th scope="col" role="columnheader">Result</th>
								<th scope="col" role="columnheader">Notes</th>
							</tr>
						</thead>
						<tbody role="rowgroup">
							for _, c := range v.Caps {
								<tr role="row">
									<td role="cell" data-label="Encoder">
										<span class="setup-hardware__encoder">
											{ c.Label }
											<span class="setup-hardware__backend mono">{ c.Backend }</span>
										</span>
									</td>
									<td role="cell" data-label="Codec" class="mono">{ c.Codec }</td>
									<td role="cell" data-label="Device" class="mono">
										if c.Device != "" {
											{ c.Device }
										} else {
											<span class="setup-muted">None</span>
										}
									</td>
									<td role="cell" data-label="Result">
										<span class={ "setup-verdict", "setup-verdict--" + c.Result }>
											<span class="setup-verdict__mark" aria-hidden="true">{ setupResultMark(c.Result) }</span>
											{ setupResultWord(c.Result) }
										</span>
									</td>
									<td role="cell" data-label="Notes">{ c.Notes }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			<div class="actions">
				<button
					class="btn btn--secondary"
					type="submit"
					name="action"
					value="retest"
					formaction={ v.Action }
					hx-post={ v.Action }
					hx-target="#hardware-body"
					hx-swap="outerHTML"
					hx-disabled-elt="this"
				>Test again</button>
				if v.TestedAt != "" {
					<p class="actions__note">Last tested { v.TestedAt }.</p>
				}
			</div>
		}
	</div>
}

// ---------- 6. Default strategy ----------

// SetupQualityOptions are the quality tiers in viewing terms.
var SetupQualityOptions = []Option{
	{Value: "maximum", Label: "Maximum", Hint: "Keeps the most detail. Saves the least space."},
	{Value: "high", Label: "High", Hint: "Hard to tell apart from the original on a large screen."},
	{Value: "balanced", Label: "Balanced", Hint: "Looks good on most TVs and saves more space."},
	{Value: "space_saver", Label: "Space Saver", Hint: "Fine for phones and tablets. Saves the most space."},
}

var setupCodecOptions = []Option{
	{Value: "hevc", Label: "HEVC", Hint: "About half the size of H.264 at the same quality. Plays on most modern TVs and devices."},
	{Value: "h264", Label: "H.264", Hint: "Plays everywhere, but files are larger."},
	{Value: "av1", Label: "AV1", Disabled: true},
}

// SetupEncoderOptions are the encoder preferences.
var SetupEncoderOptions = []Option{
	{Value: "hardware", Label: "Auto", Hint: "Uses a hardware encoder that passed the test, and software otherwise."},
	{Value: "software", Label: "Software only", Hint: "Slower, but gives the same result on any machine."},
}

// SetupDefaults is step 6.
templ SetupDefaults(v SetupDefaultsView, assetVersion string) {
	@SetupLayout("Default strategy", 6, SetupTotalSteps, assetVersion) {
		@PageHeader("Default strategy", "How JellyTrim converts files when a policy does not say otherwise.")
		<form class="setup-step" method="post" action="/setup/defaults">
			if v.Error != "" {
				@CalloutWith(CalloutProps{Variant: "bad", Title: v.Error, Alert: true})
			}
			@Panel("Defaults", "setup-defaults") {
				<div class="setup-fields">
					@Segmented("quality", "Quality", SetupQualityOptions, v.Quality, "")
					@Segmented("codec", "Codec", setupCodecOptions, v.Codec, "")
					@Segmented("encoder", "Encoder", SetupEncoderOptions, v.Encoder, "")
				</div>
			}
			<p class="setup-note">Policies can override these. Encoder settings are under Advanced in Settings.</p>
			<p class="setup-note">Encoding runs at any time by default. You can limit it to certain hours in Settings.</p>
			@setupActions("/setup/hardware")
		</form>
	}
}

// ---------- 7. Starter policies ----------

// SetupPolicies is step 7.
templ SetupPolicies(v SetupPoliciesView, assetVersion string) {
	@SetupLayout("Starter policies", 7, SetupTotalSteps, assetVersion) {
		@PageHeader("Starter policies", "Four common rules to start from. You can edit them later on the Policies page.")
		<form class="setup-step" method="post" action="/setup/policies">
			@Callout("info", "", "Protect favourites is on. The others are created switched off. Turn them on after you have checked the Dry Run.")
			if v.Existing {
				<p class="setup-note">These policies already exist. Continuing keeps them and updates which are on.</p>
			}
			<div class="setup-cards">
				for i, c := range v.Cards {
					@PanelWith(PanelProps{Tab: c.Name, ID: setupCardID(i)}) {
						<div class="setup-card">
							<p class="setup-card__sentence">{ c.Sentence }</p>
							@Toggle("enabled", "Enabled", c.Enabled, templ.Attributes{"value": c.Name, "aria-describedby": setupCardID(i) + "-tab"})
							if c.TV {
								@setupTVPicker(v.TVLibraries)
							}
						</div>
					}
				}
			</div>
			@setupActions("/setup/defaults")
		</form>
	}
}

templ setupTVPicker(libs []SetupLibrary) {
	<fieldset class="setup-checklist">
		<legend class="setup-checklist__legend">Which libraries?</legend>
		if len(libs) == 0 {
			<p class="setup-note">No managed show libraries. With none chosen, it applies to episodes in every managed library.</p>
		} else {
			<p class="field__hint">With none chosen, it applies to episodes in every managed library.</p>
		}
		<ul class="setup-checklist__list setup-checklist__list--inline">
			for _, l := range libs {
				<li class="setup-checklist__item">
					<label class="check">
						<input type="checkbox" name="tv" value={ l.ID } checked?={ l.Checked }/>
						<span>{ l.Name }</span>
					</label>
				</li>
			}
		</ul>
	</fieldset>
}

// ---------- 8. Dry Run scan ----------

// SetupScan is step 8.
templ SetupScan(v SetupScanView, assetVersion string) {
	@SetupLayout("Dry Run scan", 8, SetupTotalSteps, assetVersion) {
		@PageHeader("Dry Run scan", "JellyTrim reads your library, inspects each file and checks it against your policies. It changes nothing.")
		@Panel("Scan", "setup-scan") {
			@SetupScanStatus(v)
		}
		if v.State == "ready" {
			<div class="setup__actions">
				<a class="btn btn--secondary" href="/setup/policies">Back</a>
			</div>
		}
	}
}

// SetupScanStatus is the live scan status. While the scan runs it polls
// GET /setup/scan every second and replaces itself; the finished state has
// no trigger, so polling stops.
templ SetupScanStatus(v SetupScanView) {
	switch v.State {
		case "running":
			<div class="setup-scan" id="setup-scan-status" hx-get="/setup/scan" hx-trigger="every 1s" hx-swap="outerHTML">
				<p class="setup-scan__phase">
					@Lamp("active")
					<span>{ v.Phase }</span>
				</p>
				@Meter("setup-scan-meter", v.Percent, v.Readout)
				<p class="setup-note">You can leave this page. The scan keeps running.</p>
			</div>
		case "failed":
			<div class="setup-scan" id="setup-scan-status">
				@CalloutWith(CalloutProps{Variant: "bad", Title: "The scan stopped", Text: "JellyTrim could not finish the scan. Nothing was changed. Check the connection and path mappings, then try again."}) {
					if v.Error != "" {
						@TechnicalDetails("Technical details", v.Error)
					}
				}
				<form class="actions" method="post" action="/setup/scan">
					<button class="btn btn--primary" type="submit">Try again</button>
					<a class="btn btn--secondary" href="/setup/paths">Check path mappings</a>
				</form>
			</div>
		case "done":
			<div class="setup-scan" id="setup-scan-status">
				<p class="setup-scan__phase" role="status">
					@Lamp("ok")
					<span>Dry Run scan complete. No files were changed.</span>
				</p>
				if v.Summary != nil {
					@setupScanSummary(*v.Summary)
				}
				<div class="actions">
					<a class="btn btn--primary" href="/">Go to Dashboard</a>
				</div>
			</div>
		default:
			<div class="setup-scan" id="setup-scan-status">
				<p>The scan reads every managed library, inspects new or changed files with ffprobe and works out what each policy would do. A first scan of a large library can take a while.</p>
				<form class="actions" method="post" action="/setup/scan">
					<button class="btn btn--primary" type="submit">Start Dry Run scan</button>
				</form>
			</div>
	}
}

templ setupScanSummary(s SetupScanSummary) {
	@Metrics() {
		@Metric("Items checked", s.Evaluated, "", "", false)
		@Metric("Would optimise", s.Optimise, "", "Only enabled policies count.", false)
		@Metric("Could save", s.SavingValue, s.SavingUnit, s.SavingNote, s.Estimate)
	}
	if len(s.Lines) > 0 {
		<ul class="setup-scan__lines">
			for _, l := range s.Lines {
				<li><span class="setup-scan__count mono">{ l.Count }</span> { l.Text }</li>
			}
		</ul>
	}
}
