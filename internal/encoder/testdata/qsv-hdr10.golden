-nostdin
-hide_banner
-loglevel error
-progress pipe:1
-nostats
-y
-init_hw_device vaapi=va:/dev/dri/renderD128,driver=iHD
-init_hw_device qsv=qs@va
-filter_hw_device qs
-hwaccel qsv
-hwaccel_output_format qsv
-i file:/media/movies/Delta (2022)/Delta (2022).mkv
-map 0:0
-map 0:1
-map_metadata 0
-map_chapters 0
-c copy
-c:v:0 hevc_qsv
-preset:v:0 slow
-global_quality:v:0 22
-profile:v:0 main10
-filter:v:0 vpp_qsv=format=p010,setparams=color_primaries=bt2020:color_trc=smpte2084:colorspace=bt2020nc
-color_primaries:v:0 bt2020
-color_trc:v:0 smpte2084
-colorspace:v:0 bt2020nc
-disposition:v:0 0
-metadata:s:v:0 BPS=
-metadata:s:v:0 BPS-eng=
-metadata:s:v:0 NUMBER_OF_BYTES=
-metadata:s:v:0 NUMBER_OF_BYTES-eng=
-metadata:s:v:0 NUMBER_OF_FRAMES=
-metadata:s:v:0 NUMBER_OF_FRAMES-eng=
-metadata:s:v:0 DURATION=
-metadata:s:v:0 DURATION-eng=
-metadata:s:v:0 _STATISTICS_TAGS=
-metadata:s:v:0 _STATISTICS_TAGS-eng=
-metadata:s:v:0 _STATISTICS_WRITING_APP=
-metadata:s:v:0 _STATISTICS_WRITING_APP-eng=
-metadata:s:v:0 _STATISTICS_WRITING_DATE_UTC=
-metadata:s:v:0 _STATISTICS_WRITING_DATE_UTC-eng=
-metadata JELLYTRIM=v1;enc=qsv-hevc;q=high
-max_muxing_queue_size 4096
-f matroska
file:/media/movies/Delta (2022)/.Delta (2022).mkv.jellytrim-42.partial
