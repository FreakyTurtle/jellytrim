#!/usr/bin/env bash
# Installed by `task setup` (git config core.hooksPath .githooks).
set -euo pipefail
root=$(git rev-parse --show-toplevel)
"$root/scripts/check-public.sh"
# Generated templ output must be committed alongside its source.
if git diff --cached --name-only | grep -q '\.templ$'; then
  stale=$(git diff --name-only -- '*_templ.go')
  if [ -n "$stale" ]; then
    echo "pre-commit: templ output changed but is not staged. Run 'task generate' and stage:" >&2
    echo "$stale" >&2
    exit 1
  fi
fi
