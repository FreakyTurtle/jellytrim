# Personal denylist for scripts/check-public.sh
.public-denylist

# Claude Code: personal and ephemeral state. Committed: CLAUDE.md, .mcp.json,
# .claude/{settings.json,agents,skills,rules,hooks,scripts,output-styles,agent-memory}.
.claude/settings.local.json
.claude/agent-memory-local/
.claude/worktrees/
CLAUDE.local.md

# Codex: personal state (the generated .codex/agents and .agents/skills are committed)
.codex/*.local.*

