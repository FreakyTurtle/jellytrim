# JellyTrim bootstrap settings. Everything else is configured in the web UI
# and stored in the SQLite database in the config directory.
# Copy the lines you need into your compose file's `environment:` section.

# Address to listen on. In Docker keep :8080 and publish the port.
JELLYTRIM_LISTEN=:8080

# Where JellyTrim keeps its database and backups metadata. Mount a volume here.
JELLYTRIM_CONFIG_DIR=/config

# Optional: preset the Jellyfin connection instead of entering it in setup.
# JELLYTRIM_JELLYFIN_URL=http://jellyfin:8096
# Prefer the _FILE form with a Docker secret over putting the key here.
# JELLYTRIM_JELLYFIN_API_KEY=your-api-key
# JELLYTRIM_JELLYFIN_API_KEY_FILE=/run/secrets/jellyfin_api_key

# ffmpeg and ffprobe. The official image sets these to jellyfin-ffmpeg.
# JELLYTRIM_FFMPEG=ffmpeg
# JELLYTRIM_FFPROBE=ffprobe

# Logging: debug, info, warn, error. Format: text or json.
JELLYTRIM_LOG_LEVEL=info
JELLYTRIM_LOG_FORMAT=text

# Time zone for the weekly processing schedule and the daily sync time.
# TZ=Europe/London
